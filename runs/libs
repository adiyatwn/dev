#!/usr/bin/env bash

set -e

echo "=== Installing Core Dev Tools & CLI Utilities ==="

if command -v apt-get &> /dev/null; then
  sudo apt-get update && sudo apt-get install -y build-essential curl wget git unzip ripgrep fd-find
elif command -v pacman &> /dev/null; then
  sudo pacman -S --noconfirm base-devel curl wget git unzip ripgrep fd
fi

echo "=== Core Dev Tools installed ==="
