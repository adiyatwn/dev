#!/usr/bin/env bash

set -e

echo "=== Install Tmux ==="
if command -v apt-get &> /dev/null; then
  sudo apt-get update && sudo apt-get install -y tmux git
elif command -v pacman &> /dev/null; then
  sudo pacman -S --noconfirm tmux git
fi

echo "=== Install Tmux Plugin Manager (TPM) ==="
if [ ! -d "$HOME/.tmux/plugins/tpm" ]; then
  mkdir -p "$HOME/.tmux/plugins"
  git clone https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"
else
  echo "TPM already installed."
fi

echo "=== Tmux installation complete. Run ./dev-env to link tmux.conf, then press <prefix>+I in tmux ==="
