#!/usr/bin/env bash

set -e

echo "===== Build Neovim from Source ====="

if command -v apt-get &> /dev/null; then
  sudo apt-get update
  sudo apt-get install -y ninja-build gettext cmake unzip curl build-essential git
elif command -v pacman &> /dev/null; then
  sudo pacman -S --noconfirm base-devel cmake unzip ninja curl gettext git
fi

mkdir -p "$HOME/personal"

if [ ! -d "$HOME/personal/neovim" ]; then
  git clone -b v0.11.5 https://github.com/neovim/neovim.git "$HOME/personal/neovim"
else
  cd "$HOME/personal/neovim"
  git fetch --tags
  git checkout v0.11.5
fi

cd "$HOME/personal/neovim"
make CMAKE_BUILD_TYPE=RelWithDebInfo
sudo make install

echo "===== Neovim build complete! Run ./dev-env to link your config. ====="
