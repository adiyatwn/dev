#!/usr/bin/env bash

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
dry="0"
link_hyde="0"
link_specific="0"

while [[ $# > 0 ]]; do
  case "$1" in
    --dry) dry="1" ;;
    --hyde) link_hyde="1" ;;
    --specific) link_specific="1" ;;
    *) echo "Unknown flag: $1"; exit 1 ;;
  esac
  shift
done

log() {
  if [[ $dry == "1" ]]; then
    echo "[DRY_RUN]: $@"
  else
    echo "$@"
  fi
}

execute() {
  log "execute: $@"
  if [[ $dry == "1" ]]; then
    return
  fi

  "$@"
}

log "--------- dev-env (Symlinking) ---------"

cd "$script_dir"

link_dir() {
  pushd "$1" > /dev/null || return
  to="$2"
  mkdir -p "$to"
  dirs=$(find . -maxdepth 1 -mindepth 1 -type d)
  for dir in $dirs; do
    dir_name=$(basename "$dir")
    target_abs="$(realpath "$dir")"
    execute rm -rf "$to/$dir_name"
    execute ln -sfn "$target_abs" "$to/$dir_name"
  done
  popd > /dev/null || return
}

link_file() {
  from="$(realpath "$1")"
  to="$2"
  name=$(basename "$from")
  mkdir -p "$to"
  execute rm -rf "$to/$name"
  execute ln -sfn "$from" "$to/$name"
}

# Symlink main user configs
link_dir .config "$HOME/.config"
link_dir .local "$HOME/.local"
link_file .ready-tmux "$HOME"

# Symlink Pi agent config (.config/pi/agent -> $HOME/.pi/agent)
mkdir -p "$HOME/.pi"
link_file .config/pi/agent "$HOME/.pi"

# Optional desktop profile configs
if [[ "$link_specific" == "1" ]]; then
  log "=== Linking .config_specific ==="
  link_dir .config_specific "$HOME/.config"
fi

if [[ "$link_hyde" == "1" ]]; then
  log "=== Linking .config_HyDE ==="
  link_dir .config_HyDE "$HOME/.config"
fi
